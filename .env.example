# このファイルをコピーして .env を作り、値を入れる（.env はコミットしない）

# Neplector の API
NEPLECTOR_BASE_URL=https://neplector.example.com
# /neplector key で作ったキー。サービスごとに分ける（このサービス専用のものを使う）
NEPLECTOR_API_KEY=

# 同期専用の bot の token（Neplector の bot とは別のアプリにする）
DISCORD_BOT_TOKEN=

# 運営者への知らせを送る Webhook の URL（同期カテゴリの外のチャンネルに作る）
OPS_WEBHOOK_URL=
